<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/product.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <% if (errorMessage) { %>
            <div class="user-message user-message--error"><%= errorMessage %></div>
        <% } %>
        <form class="product-form" action="/admin/<% if (editing) { %>edit-product<% } else { %>add-product<% } %>" method="POST" enctype="multipart/form-data">
            <div class="form-control">
                <label class="<%= validationErrors.find(e => e.path === 'title') ? 'invalid' : '' %>" for="title">Title</label>
                <input
                    class="<%= validationErrors.find(e => e.path === 'title') ? 'invalid' : '' %>"
                    type="text" name="title" id="title"
                    value="<% if (editing) { %><%= product.title %><% } else { %><%= oldContent.title %><% } %>">
                <% validationErrors.filter(e => e.path === 'title').forEach(err => { %>
                    <span class="error-text"><%= err.msg %></span>
                <% }) %>
            </div>
            <div class="form-control">
                <label for="image">Image</label>
                <input
                    type="file" name="image" id="image">
            </div>
            <div class="form-control">
                <label class="<%= validationErrors.find(e => e.path === 'price') ? 'invalid' : '' %>" for="price">Price</label>
                <input
                    class="<%= validationErrors.find(e => e.path === 'price') ? 'invalid' : '' %>"
                    type="number" name="price" id="price" step="0.01"
                    value="<% if (editing) { %><%= product.price %><% } else { %><%= oldContent.price %><% } %>">
                <% validationErrors.filter(e => e.path === 'price').forEach(err => { %>
                    <span class="error-text"><%= err.msg %></span>
                <% }) %>
            </div>
            <div class="form-control">
                <label class="<%= validationErrors.find(e => e.path === 'description') ? 'invalid' : '' %>" for="description">Description</label>
                <textarea
                    class="<%= validationErrors.find(e => e.path === 'description') ? 'invalid' : '' %>"
                    name="description" id="description" rows="5"><% if (editing) { %><%= product.description %><% } else { %><%= oldContent.description %><% } %></textarea>
                <% validationErrors.filter(e => e.path === 'description').forEach(err => { %>
                    <span class="error-text"><%= err.msg %></span>
                <% }) %>
            </div>
            <% if (editing) { %>
                <input type="hidden" value="<%= product._id %>" name="productId">
            <% } %>

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit"><% if (editing) { %>Update Product<% } else { %>Add Product<% } %></button>
        </form>
    </main>
<%- include('../includes/end.ejs') %>